# ═══════════════════════════════════════════════════════════════
# Servicios OCC — Producción (MySQL + Redis + HTTPS)
# ═══════════════════════════════════════════════════════════════
# COPIAR: cp .env.prod.example .env.prod && nano .env.prod
# ═══════════════════════════════════════════════════════════════

# ── MySQL ─────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=occ_vulns
MYSQL_USER=occ_admin
MYSQL_PASSWORD=OCC_S3cur3_P4ss!
MYSQL_ROOT_PASSWORD=OCC_R00t_P4ss!
DATABASE_URL=mysql://occ_admin:OCC_S3cur3_P4ss!@mysql:3306/occ_vulns

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=OCC_R3d1s_P4ss!
REDIS_URL=redis://:OCC_R3d1s_P4ss!@redis:6379

# ── JWT ───────────────────────────────────────────────────────
# ⚠️ Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_GENERAR_CON_OPENSSL
JWT_EXPIRATION=8h

# ── NVD API ──────────────────────────────────────────────────
# Obtener en: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── GitHub (mejora rate limit para PoCs) ─────────────────────
GITHUB_TOKEN=

# ── Collector ────────────────────────────────────────────────
VULN_COLLECTOR_INTERVAL_MINUTES=30
VULN_COLLECTOR_LOOKBACK_HOURS=1
VULN_COLLECTOR_EXPLOIT_CHECK_ENABLED=true
VULN_COLLECTOR_MIN_SEVERITY_FOR_EXPLOIT_CHECK=HIGH

# ── Puertos ──────────────────────────────────────────────────
OCC_HTTP_PORT=80
OCC_HTTPS_PORT=443

# ── IA (Ollama / OpenAI) ─────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
