# ═══════════════════════════════════════════════════════════════
# Servicios OCC — Producción (SQLite + HTTPS)
# ═══════════════════════════════════════════════════════════════
# COPIAR: cp .env.prod.example .env.prod && nano .env.prod
# ═══════════════════════════════════════════════════════════════

# ── JWT ───────────────────────────────────────────────────────
# ⚠️ Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_GENERAR_CON_OPENSSL
JWT_EXPIRATION=8h

# ── NVD API ──────────────────────────────────────────────────
# Obtener en: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── GitHub (mejora rate limit para PoCs) ─────────────────────
GITHUB_TOKEN=

# ── Collector ────────────────────────────────────────────────
VULN_COLLECTOR_INTERVAL_MINUTES=30
VULN_COLLECTOR_LOOKBACK_HOURS=1
VULN_COLLECTOR_EXPLOIT_CHECK_ENABLED=true
VULN_COLLECTOR_MIN_SEVERITY_FOR_EXPLOIT_CHECK=HIGH

# ── Puertos ──────────────────────────────────────────────────
OCC_HTTP_PORT=80
OCC_HTTPS_PORT=443

# ── SMTP (correo electrónico) ────────────────────────────────
# Configurar si quieres notificaciones por email
# Proveedores comunes:
#   Gmail:      smtp.gmail.com:587  (usar App Password)
#   Office365:  smtp.office365.com:587
#   Postfix:    localhost:25
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=occ@servicios-occ.local
