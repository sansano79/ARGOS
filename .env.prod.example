# ═══════════════════════════════════════════════════════════════
# Servicios OCC — Producción (MySQL + Redis + HTTPS)
# ═══════════════════════════════════════════════════════════════
# COPIAR: cp .env.prod.example .env.prod && nano .env.prod
# ═══════════════════════════════════════════════════════════════

# ── MySQL ─────────────────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=occ_vulns
MYSQL_USER=occ_admin
MYSQL_PASSWORD=OCC_S3cur3_P4ss!
MYSQL_ROOT_PASSWORD=OCC_R00t_P4ss!
DATABASE_URL=mysql://occ_admin:OCC_S3cur3_P4ss!@mysql:3306/occ_vulns

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=OCC_R3d1s_P4ss!
REDIS_URL=redis://:OCC_R3d1s_P4ss!@redis:6379

# ── JWT ───────────────────────────────────────────────────────
# ⚠️ Generar con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_GENERAR_CON_OPENSSL
JWT_EXPIRATION=8h

# ── Seguridad API / Proxy ─────────────────────────────────────
NODE_ENV=production
APP_PORT=3000
TRUST_PROXY=1
CORS_ORIGIN=https://app.tu-dominio.com
ENABLE_SWAGGER=false
BODY_LIMIT=10mb
FRONTEND_BASE_URL=https://app.tu-dominio.com/

# ── Prisma (startup behavior) ─────────────────────────────────
# En producción se recomienda "false" y ejecutar db push/manual en una ventana controlada.
PRISMA_DB_PUSH_ON_START=false
PRISMA_MIGRATE_ON_START=true

# ── NVD API ──────────────────────────────────────────────────
# Obtener en: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# ── GitHub (mejora rate limit para PoCs) ─────────────────────
GITHUB_TOKEN=

# ── Collector ────────────────────────────────────────────────
VULN_COLLECTOR_INTERVAL_MINUTES=30
VULN_COLLECTOR_LOOKBACK_HOURS=1
VULN_COLLECTOR_EXPLOIT_CHECK_ENABLED=true
VULN_COLLECTOR_MIN_SEVERITY_FOR_EXPLOIT_CHECK=HIGH

# ── Puertos ──────────────────────────────────────────────────
OCC_HTTP_PORT=80
OCC_HTTPS_PORT=443

# ── IA (Ollama / OpenAI) ─────────────────────────────────────
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=krith/qwen2.5-32b-instruct:IQ1_M

# ── MFA (solo cuentas locales) ────────────────────────────────
# Clave AES-256-GCM en base64 (32 bytes). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=CAMBIAR_GENERAR_CON_NODE
MFA_ISSUER=Servicios OCC
MFA_TOKEN_EXPIRATION=10m

# ── Azure AD SAML SSO ─────────────────────────────────────────
AZURE_SAML_ENABLED=true
AZURE_SAML_ENTRY_POINT=
AZURE_SAML_ISSUER=
# Debe ser URL pública accesible por el navegador/Azure, normalmente sin :3000 (va por Nginx)
AZURE_SAML_CALLBACK_URL=https://app.tu-dominio.com/api/auth/saml/acs
# Certificado de Azure (IdP) en PEM. Puedes pegarlo con \n:
# AZURE_SAML_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
AZURE_SAML_CERT=
# Opcional: certificado de firma SP para metadata (si usas firma de requests)
AZURE_SAML_SIGNING_CERT=
AZURE_SAML_DEFAULT_ROLE=USER
AZURE_SAML_GROUP_ROLE_MAP={}

# ── Azure AD OIDC (client secret) ─────────────────────────────
AZURE_OIDC_ENABLED=true
AZURE_TENANT_ID=
AZURE_OIDC_CLIENT_ID=
AZURE_OIDC_CLIENT_SECRET=
AZURE_OIDC_REDIRECT_URI=https://app.tu-dominio.com/api/auth/azure/callback
AZURE_OIDC_DEFAULT_ROLE=USER
AZURE_OIDC_GROUP_ROLE_MAP={}

# ── Alta local con aprobación por email ────────────────────────
PUBLIC_BASE_URL=https://app.tu-dominio.com
LOCAL_SIGNUP_ENABLED=false
LOCAL_SIGNUP_APPROVER_EMAIL=security@tu-dominio.com
LOCAL_SIGNUP_EXPIRY_MINUTES=60
