# ══════════════════════════════════════════════════════════════
# ARGOS — Threat & Vulnerability Management
# Copia este archivo como .env.prod y completa los secretos.
# No reutilices valores de ejemplo ni versiones este archivo con secretos.
# ══════════════════════════════════════════════════════════════

# ── Aplicación ────────────────────────────────────────────────
NODE_ENV=development
OCC_ENV=production
APP_PORT=3000
APP_NAME="ARGOS - Threat & Vulnerability Management"

# ── MySQL ─────────────────────────────────────────────────────
# En Docker, MYSQL_HOST debe ser mysql. En ejecución local puede ser localhost.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=argos
MYSQL_USER=argos_admin
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
DATABASE_URL=mysql://argos_admin:CHANGE_ME@localhost:3306/argos

# ── Redis ─────────────────────────────────────────────────────
# En Docker, REDIS_HOST debe ser redis. En ejecución local puede ser localhost.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@localhost:6379

# ── JWT ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRATION=8h

# ── NVD (NIST) API ────────────────────────────────────────────
NVD_API_KEY=

# ── GitHub ────────────────────────────────────────────────────
GITHUB_TOKEN=

# ── Collector Settings ────────────────────────────────────────
VULN_COLLECTOR_INTERVAL_MINUTES=30
VULN_COLLECTOR_LOOKBACK_HOURS=1
VULN_COLLECTOR_EXPLOIT_CHECK_ENABLED=true
VULN_COLLECTOR_MIN_SEVERITY_FOR_EXPLOIT_CHECK=MEDIUM

# ── Risk Formula ──────────────────────────────────────────────
RISK_FORMULA_VERSION=v1

# ── CVE.org ───────────────────────────────────────────────────
CVEORG_ENABLED=false
CVEORG_API_URL=https://cveawg.mitre.org/api/cve
CVEORG_TIMEOUT_MS=30000

# ── ExploitDB ─────────────────────────────────────────────────
EXPLOITDB_ENABLED=false
EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
EXPLOITDB_CACHE_TTL_HOURS=12
EXPLOITDB_TIMEOUT_MS=60000

# ── OSV ───────────────────────────────────────────────────────
OSV_ENABLED=false
OSV_BASE_URL=https://api.osv.dev/v1
OSV_TIMEOUT_MS=20000

# ── Report Settings ───────────────────────────────────────────
VULN_REPORT_DEFAULT_PERIOD_HOURS=24
VULN_REPORT_MIN_SEVERITY=MEDIUM
VULN_REPORT_OUTPUT_DIR=./storage/reports

# ── Puppeteer ─────────────────────────────────────────────────
PUPPETEER_EXECUTABLE_PATH=

# ── Frontend / HTTP ───────────────────────────────────────────
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173/
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false
BODY_LIMIT=10mb
ENABLE_SWAGGER=true
PRISMA_MIGRATE_ON_START=false
PRISMA_DB_PUSH_ON_START=false
OCC_HTTP_PORT=80
OCC_HTTPS_PORT=443

# ── Password Reset ────────────────────────────────────────────
PASSWORD_RESET_EXPIRY_MINUTES=20

# ── Ollama ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── MFA ───────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=
MFA_ISSUER=ARGOS
MFA_TOKEN_EXPIRATION=10m
TEST_DATA_SEED_ENABLED=false
TEST_USERS_PASSWORD=
MFA_TEST_BYPASS_ENABLED=false
MFA_TEST_BYPASS_EMAILS=
MFA_DEV_BYPASS_ENABLED=false

# ── Azure AD SAML SSO ─────────────────────────────────────────
AZURE_SAML_ENABLED=false
AZURE_SAML_ENTRY_POINT=
AZURE_SAML_ISSUER=
AZURE_SAML_CALLBACK_URL=http://localhost:3000/api/auth/saml/acs
AZURE_SAML_CERT=
AZURE_SAML_SIGNING_CERT=
AZURE_SAML_DEFAULT_ROLE=USER
AZURE_SAML_GROUP_ROLE_MAP={}

# ── Azure AD OIDC ─────────────────────────────────────────────
AZURE_OIDC_ENABLED=false
AZURE_TENANT_ID=
AZURE_OIDC_CLIENT_ID=
AZURE_OIDC_CLIENT_SECRET=
AZURE_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/azure/callback
AZURE_OIDC_DEFAULT_ROLE=USER
AZURE_OIDC_GROUP_ROLE_MAP={}
AZURE_OIDC_USER_ROLE_MAP={}
AZURE_OIDC_APP_ROLE_VALUE_MAP={}

# ── Alta local con aprobación por email ───────────────────────
PUBLIC_BASE_URL=http://localhost:3000
LOCAL_SIGNUP_ENABLED=false
LOCAL_SIGNUP_APPROVER_EMAIL=
LOCAL_SIGNUP_EXPIRY_MINUTES=60

# ── API externa ───────────────────────────────────────────────
API_RATE_LIMIT_TTL=60000
API_RATE_LIMIT_MAX=100
