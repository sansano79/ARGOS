generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ══════════════════════════════════════════════════════════════
// USUARIOS Y AUTENTICACIÓN
// ══════════════════════════════════════════════════════════════

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  passwordHash    String?   @map("password_hash")
  name            String
  role            String    @default("USER")
  canLogin        Boolean   @default(true) @map("can_login")
  isSubscriber    Boolean   @default(false) @map("is_subscriber")
  notificationEmail String? @map("notification_email")
  contactPerson   String?   @map("contact_person")
  department      String?
  phone           String?
  notes           String?   @db.Text
  isActive        Boolean   @default(true) @map("is_active")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions        UserSession[]
  reports         VulnerabilityReport[]
  apiConfigs      ApiConfiguration[]
  collectorRuns   CollectorRun[]
  subscriptions   UserSubscription[]
  subscriberNotifications VulnerabilityNotification[] @relation("subscriber_notifications")
  ownedSystems    SubscriberOwnedSystem[] @relation("subscriber_owned_systems")
  smartReports    SmartNotificationReport[] @relation("smart_notification_reports")
  defenderActions DefenderActionRequest[] @relation("defender_action_requests")
  notificationPolicy NotificationPolicy?
  pendingDigestNotifications PendingDigestNotification[]
  patchedCves     SubscriberPatchedCve[]

  @@map("users")
}

model UserSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  tokenHash String   @map("token_hash")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model LoginAttempt {
  id          Int      @id @default(autoincrement())
  email       String
  ipAddress   String   @map("ip_address")
  attemptedAt DateTime @default(now()) @map("attempted_at")
  success     Boolean  @default(false)

  @@index([email, attemptedAt])
  @@index([ipAddress, attemptedAt])
  @@map("login_attempts")
}

// ══════════════════════════════════════════════════════════════
// RECUPERACIÓN DE CONTRASEÑA
// ══════════════════════════════════════════════════════════════

model PasswordReset {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  @@index([tokenHash])
  @@index([email])
  @@index([expiresAt])
  @@map("password_resets")
}

// ══════════════════════════════════════════════════════════════
// VULNERABILIDADES
// ══════════════════════════════════════════════════════════════

model Vulnerability {
  id                 Int      @id @default(autoincrement())
  cveId              String   @unique @map("cve_id")

  description        String?  @db.MediumText
  publishedAt        DateTime @map("published_at")
  lastModifiedAt     DateTime? @map("last_modified_at")

  cvssV31Score       Float?   @map("cvss_v31_score")
  cvssV31Vector      String?  @map("cvss_v31_vector")
  cvssV31Severity    String?  @map("cvss_v31_severity")
  epssScore          Float?   @map("epss_score")
  epssPercentile     Float?   @map("epss_percentile")

  isKnownExploited   Boolean  @default(false) @map("is_known_exploited")
  kevDateAdded       DateTime? @map("kev_date_added")
  kevDueDate         DateTime? @map("kev_due_date")
  hasPublicExploit   Boolean  @default(false) @map("has_public_exploit")
  exploitReferences  String?  @map("exploit_references") @db.LongText
  references         String?  @db.LongText

  affectedProducts   String?  @map("affected_products") @db.LongText
  remediationInfo    String?  @map("remediation_info")  @db.LongText

  source             String   @default("nvd")
  rawData            String?  @map("raw_data") @db.LongText

  processingStatus   String   @default("new") @map("processing_status")
  firstSeenAt        DateTime @default(now()) @map("first_seen_at")
  enrichedAt         DateTime? @map("enriched_at")

  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  tags               VulnerabilityTag[]
  notifications      VulnerabilityNotification[]
  pendingDigestNotifications PendingDigestNotification[]

  @@index([cveId])
  @@index([cvssV31Severity])
  @@index([publishedAt(sort: Desc)])
  @@index([isKnownExploited])
  @@index([processingStatus])
  @@index([epssScore(sort: Desc)])
  @@index([firstSeenAt(sort: Desc)])
  @@map("vulnerabilities")
}

// ══════════════════════════════════════════════════════════════
// INFORMES
// ══════════════════════════════════════════════════════════════

model VulnerabilityReport {
  id             Int      @id @default(autoincrement())
  reportDate     DateTime @map("report_date")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  totalCves      Int      @map("total_cves")
  criticalCount  Int      @default(0) @map("critical_count")
  highCount      Int      @default(0) @map("high_count")
  exploitedCount Int      @default(0) @map("exploited_count")
  filePath       String?  @map("file_path")
  generatedBy    Int?     @map("generated_by")

  user           User?    @relation(fields: [generatedBy], references: [id])
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("vulnerability_reports")
}

// ══════════════════════════════════════════════════════════════
// COLLECTOR RUNS
// ══════════════════════════════════════════════════════════════

model CollectorRun {
  id           Int       @id @default(autoincrement())
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  source       String
  cvesFetched  Int       @default(0) @map("cves_fetched")
  cvesNew      Int       @default(0) @map("cves_new")
  cvesUpdated  Int       @default(0) @map("cves_updated")
  manufacturersNew Int   @default(0) @map("manufacturers_new")
  productsNew  Int       @default(0) @map("products_new")
  status       String
  errorMessage String?   @map("error_message")
  durationMs   Int?      @map("duration_ms")
  triggeredBy  Int?      @map("triggered_by")

  user         User?     @relation(fields: [triggeredBy], references: [id])

  @@index([startedAt(sort: Desc)])
  @@map("collector_runs")
}

// ══════════════════════════════════════════════════════════════
// CONFIGURACIÓN APIs EXTERNAS
// ══════════════════════════════════════════════════════════════

model ApiConfiguration {
  id                Int       @id @default(autoincrement())
  name              String
  slug              String    @unique
  provider          String
  apiKeyEncrypted   String?   @map("api_key_encrypted")
  endpointUrl       String?   @map("endpoint_url")
  settings          String?   @db.LongText
  isActive          Boolean   @default(true) @map("is_active")
  lastUsedAt        DateTime? @map("last_used_at")
  createdBy         Int?      @map("created_by")

  user              User?     @relation(fields: [createdBy], references: [id])
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([provider])
  @@map("api_configurations")
}

// ══════════════════════════════════════════════════════════════
// CONTACTOS IT
// ══════════════════════════════════════════════════════════════

// ItContact model removed — legacy model replaced by User subscriber system.
// The it_contacts table remains in DB for historical data but is no longer managed by Prisma.

// ══════════════════════════════════════════════════════════════
// HISTORIAL DE NOTIFICACIONES
// ══════════════════════════════════════════════════════════════

model NotificationLog {
  id             Int      @id @default(autoincrement())
  recipientEmail String   @map("recipient_email")
  recipientName  String?  @map("recipient_name")
  subject        String
  htmlContent    String   @db.Text @map("html_content")
  cveIds         String   @default("[]") @map("cve_ids")
  status         String   @default("sent")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@index([sentAt(sort: Desc)])
  @@map("notification_logs")
}

// ══════════════════════════════════════════════════════════════
// TAGS DE VULNERABILIDADES
// ══════════════════════════════════════════════════════════════

model VulnerabilityTag {
  id              Int               @id @default(autoincrement())
  name            String            @unique
  color           String            @default("#3B6CB5")
  isAutoGenerated Boolean           @default(false) @map("is_auto_generated")

  vulnerabilities Vulnerability[]

  @@map("vulnerability_tags")
}

// ══════════════════════════════════════════════════════════════
// NOTIFICACIONES POR VULNERABILIDAD
// ══════════════════════════════════════════════════════════════

model VulnerabilityNotification {
  id              Int      @id @default(autoincrement())
  vulnerabilityId Int      @map("vulnerability_id")
  contactId       Int?     @map("contact_id")
  subscriberUserId Int?    @map("subscriber_user_id")
  recipientEmail  String   @map("recipient_email")
  recipientName   String?  @map("recipient_name")
  sentAt          DateTime @default(now()) @map("sent_at")
  status          String   @default("sent")
  notificationLogId Int?   @map("notification_log_id")

  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)
  // contact relation removed — contactId kept for historical data
  subscriberUser  User?         @relation("subscriber_notifications", fields: [subscriberUserId], references: [id], onDelete: SetNull)

  @@index([vulnerabilityId])
  @@index([contactId])
  @@index([subscriberUserId])
  @@index([sentAt(sort: Desc)])
  @@map("vulnerability_notifications")
}

// ══════════════════════════════════════════════════════════════
// CATÁLOGO SOFTWARE (FABRICANTE / PRODUCTO / VERSIONES)
// ══════════════════════════════════════════════════════════════

model SoftwareCatalog {
  id          Int      @id @default(autoincrement())
  vendor      String
  product     String
  versions    String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([vendor, product])
  @@index([vendor])
  @@index([product])
  @@map("software_catalog")
}

model Manufacturer {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("manufacturers")
}

// ══════════════════════════════════════════════════════════════
// SUSCRIPCIONES DE USUARIOS
// ══════════════════════════════════════════════════════════════

model UserSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  vendor    String
  product   String
  versions  String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, vendor, product])
  @@index([userId])
  @@index([vendor, product])
  @@map("user_subscriptions")
}

// ══════════════════════════════════════════════════════════════
// NOTIFICACIONES INTELIGENTES
// ══════════════════════════════════════════════════════════════

model SmartNotificationReport {
  id               Int       @id @default(autoincrement())
  subscriberUserId Int       @map("subscriber_user_id")
  periodStart      DateTime  @map("period_start")
  periodEnd        DateTime  @map("period_end")
  recipientEmail   String    @map("recipient_email")
  subject          String?
  status           String    @default("generated")
  aiProvider       String?   @map("ai_provider")
  aiModel          String?   @map("ai_model")
  inputSnapshot    String?   @map("input_snapshot") @db.LongText
  analysisJson     String?   @map("analysis_json") @db.LongText
  sentAt           DateTime? @map("sent_at")
  errorMessage     String?   @map("error_message") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  subscriber       User      @relation("smart_notification_reports", fields: [subscriberUserId], references: [id], onDelete: Cascade)

  @@index([subscriberUserId])
  @@index([periodEnd(sort: Desc)])
  @@index([status])
  @@map("smart_notification_reports")
}

model SubscriberOwnedSystem {
  id               Int       @id @default(autoincrement())
  subscriberUserId Int       @map("subscriber_user_id")
  externalId       String    @map("external_id")
  source           String    @default("manual")
  hostname         String
  fqdn             String?
  platform         String?
  osVersion        String?   @map("os_version")
  riskLevel        String?   @map("risk_level")
  healthStatus     String?   @map("health_status")
  onboardingStatus String?   @map("onboarding_status")
  lastSeenAt       DateTime? @map("last_seen_at")
  isSelected       Boolean   @default(true) @map("is_selected")
  isActive         Boolean   @default(true) @map("is_active")
  tags             String?   @db.Text
  rawData          String?   @map("raw_data") @db.LongText
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  subscriber       User      @relation("subscriber_owned_systems", fields: [subscriberUserId], references: [id], onDelete: Cascade)

  @@unique([subscriberUserId, externalId])
  @@index([subscriberUserId])
  @@map("subscriber_owned_systems")
}

model DefenderActionRequest {
  id               Int       @id @default(autoincrement())
  subscriberUserId Int       @map("subscriber_user_id")
  actionId         String    @map("action_id")
  actionName       String    @map("action_name")
  systemExternalIds String   @map("system_external_ids") @db.Text
  status           String    @default("planned")
  notes            String?   @db.Text
  requestedBy      String?   @map("requested_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  subscriber       User      @relation("defender_action_requests", fields: [subscriberUserId], references: [id], onDelete: Cascade)

  @@index([subscriberUserId])
  @@map("defender_action_requests")
}

model SubscriberPatchedCve {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  cveId     String   @map("cve_id")
  patchedAt DateTime @default(now()) @map("patched_at")
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cveId])
  @@index([userId])
  @@index([cveId])
  @@map("subscriber_patched_cves")
}

// ══════════════════════════════════════════════════════════════
// POLÍTICAS DE NOTIFICACIÓN Y DIGEST
// ══════════════════════════════════════════════════════════════

model NotificationPolicy {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @unique @map("user_id")
  immediateForCritical    Boolean  @default(true) @map("immediate_for_critical")
  immediateForExploitable Boolean  @default(true) @map("immediate_for_exploitable")
  digestFrequency         String   @default("daily") @map("digest_frequency")
  digestHour              Int      @default(8) @map("digest_hour")
  digestDayOfWeek         Int?     @map("digest_day_of_week")
  minCvssForImmediate     Float    @default(9.0) @map("min_cvss_for_immediate")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_policies")
}

model PendingDigestNotification {
  id              Int      @id @default(autoincrement())
  userId          Int      @map("user_id")
  vulnerabilityId Int      @map("vulnerability_id")
  vendor          String
  createdAt       DateTime @default(now()) @map("created_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@unique([userId, vulnerabilityId])
  @@index([userId])
  @@map("pending_digest_notifications")
}
